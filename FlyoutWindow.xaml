<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SonarFlyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle x:Name="FrameKeeper" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Fill="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />

        <StackPanel Padding="12,12,12,12">
            <InfoBar x:Name="Error" Severity="Warning" IsClosable="False" Margin="0,0,0,8" />

            <TextBlock x:Uid="SoundHeader" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,4" />
            <ContentPresenter x:Name="MasterHost" />

            <Grid Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Uid="OutputHeader" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,0" />
                    <TextBlock x:Name="PerChannelHint" x:Uid="PerChannelHint" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
                <ToggleButton x:Name="SyncOutputs" HorizontalAlignment="Right" Width="28" Height="24" Padding="0"
                              x:Uid="SyncOutputs" Style="{StaticResource SubtleToggleButtonStyle}">
                    <ToggleButton.Resources>
                        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorTertiaryBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    </ToggleButton.Resources>
                    <FontIcon x:Name="SyncIcon" FontSize="13" Glyph="&#xE71B;" />
                </ToggleButton>
            </Grid>
            <ListView x:Name="Outputs" x:Uid="Outputs" SelectionMode="Single" IsItemClickEnabled="True">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
            </ListView>
            <TextBlock x:Uid="MixerHeader" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="Channels" />

            <TextBlock x:Uid="InputHeader" Style="{StaticResource SectionHeaderStyle}" />
            <ContentPresenter x:Name="MicHost" />
            <ListView x:Name="Inputs" x:Uid="Inputs" SelectionMode="Single">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
            </ListView>
        </StackPanel>

        <Grid Grid.Row="1" Padding="16,6,8,6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Uid="FooterTitle" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="OpenGG" HorizontalAlignment="Right" Width="36" Height="36" Padding="0"
                    x:Uid="OpenGG" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>
    </Grid>
</Window>
